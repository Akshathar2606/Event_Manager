# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventflow?retryWrites=true&w=majority

# JWT Authentication Secret Key & Expiration
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Password recovery email (use an SMTP sandbox for local development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=EventFlow <no-reply@example.com>
CLIENT_BASE_URL=http://localhost:5173

# Environment
NODE_ENV=development
